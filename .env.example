# 이 파일을 복사해서 .env 로 만들고 실제 값을 채운다.
# .env 자체는 git 에 올리지 않는다 (.gitignore 에 이미 걸려 있음).

# ---------------------------------------------------------------- Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=1
# 콤마로 구분한 origin 목록. 운영 배포 시 채울 것.
DJANGO_CSRF_ORIGINS=

# ---------------------------------------------------------------- Redis
# 비워두면 %TEMP%\reid_bus 파일 폴백으로 동작한다 (느림, 개발용).
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------- jetson / 메인 서버 연동
# 개발 중: Jetson A 보드에 직접 연결해서 테스트.
# 최종: 메인 서버(10.10.20.33)의 Mosquitto 로 바뀔 예정.
JETSON_MQTT_HOST=10.10.20.56
JETSON_MQTT_PORT=1883
JETSON_MQTT_TOPIC=cctv/entry

# node_a.py / node_b.py 가 직접 서빙하는 MJPEG 스트림.
# Camera C 는 아직 미가동이라 비워두면 대시보드가 빈 슬롯으로 보여준다.
JETSON_CAM_A_URL=http://10.10.20.56:8000/stream
JETSON_CAM_B_URL=http://10.10.20.56:8001/stream
JETSON_CAM_C_URL=
JETSON_CAM_D_URL=http://10.10.20.56:8002/stream
